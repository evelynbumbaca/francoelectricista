---
import { Image } from 'astro:assets';
import BotonLuz from './BotonLuz.astro';
import { linkWhatsapp } from '../data/sitio.js';
import { buscarFoto } from '../data/fotos.js';

const whatsappIluminacion = linkWhatsapp('iluminación de jardín');

// Tres fotos, no más. Todas de noche: es cuando la iluminación de jardín
// se ve. Son tres a propósito: tres fotos buenas se ven caras, cuatro con
// una de relleno se ven baratas, y este es el bloque que sostiene el sitio.
// Se cargan solas al copiarlas en src/images/.
const fotos = [
  {
    archivo: 'iluminacion-1.jpg',
    etiqueta: '{FOTOS_ILUMINACION — 1}',
    nota: 'La principal, y la que se ve más grande: jardín completo de noche, con los árboles iluminados desde abajo.',
    alt: 'Jardín iluminado de noche con luz cálida sobre los árboles.',
    grande: true,
  },
  {
    archivo: 'iluminacion-2.jpg',
    etiqueta: '{FOTOS_ILUMINACION — 2}',
    nota: 'Detalle de un artefacto embutido en el piso o en un cantero.',
    alt: 'Artefacto de iluminación embutido en el piso de un jardín.',
    grande: false,
  },
  {
    archivo: 'iluminacion-3.jpg',
    etiqueta: '{FOTOS_ILUMINACION — 3}',
    nota: 'Camino, escalera, borde de pileta o galería con luz a ras del piso.',
    alt: 'Camino de jardín iluminado a ras del piso.',
    grande: false,
  },
].map((foto) => ({ ...foto, imagen: buscarFoto(foto.archivo) }));
---

<section class="iluminacion halo" id="iluminacion" aria-labelledby="t-iluminacion">
  <div class="contenedor iluminacion__grilla revelar">
    <p class="rotulo iluminacion__rotulo">Servicio destacado</p>

    {/* Columna izquierda: el título y, debajo, la foto principal. La foto
        crece hasta llenar lo que sobra, así no queda un hueco abajo del
        título ni la galería queda como un bloque aparte. */}
    <div class="iluminacion__izquierda">
      <h2 class="titulo-2" id="t-iluminacion">
        Iluminación de jardín<br />y exteriores
      </h2>

      <figure
        class:list={['ilum-foto', 'ilum-foto--grande', !fotos[0].imagen && 'hueco-foto']}
      >
        {fotos[0].imagen ? (
          <Image
            class="ilum-foto__imagen"
            src={fotos[0].imagen}
            alt={fotos[0].alt}
            widths={[480, 800, 1200]}
            sizes="(min-width: 60rem) 45vw, 100vw"
            loading="lazy"
          />
        ) : (
          <Fragment>
            <p class="hueco-foto__etiqueta">{fotos[0].etiqueta}</p>
            <p class="hueco-foto__nota">{fotos[0].nota}</p>
          </Fragment>
        )}
      </figure>
    </div>

    {/* Columna derecha: el texto y, debajo, las dos fotos chicas. */}
    <div class="iluminacion__derecha">
      <div class="iluminacion__texto">
        <p class="guia">
          El jardín se usa de noche. Un proyecto de iluminación exterior define
          qué se ilumina y qué queda en sombra: los árboles desde abajo, el
          camino a ras del piso, la galería con luz cálida.
        </p>
        <p>
          Elijo artefactos aptos para intemperie, calculo la potencia y dejo los
          circuitos separados, con el comando adentro de la casa, para que
          prender el jardín sea una tecla más. Se puede hacer en obra nueva, con
          el cableado previsto desde el principio, o sobre un jardín que ya está
          hecho.
        </p>

        <ul class="iluminacion__lista">
          <li>Proyecto de iluminación exterior</li>
          <li>Artefactos aptos para intemperie</li>
          <li>Circuitos independientes y comando desde adentro</li>
          <li>Puesta en valor de árboles, caminos y galerías</li>
        </ul>

        <BotonLuz
          href={whatsappIluminacion}
          variante="primario"
          icono="whatsapp"
          contacto="whatsapp"
          origen="iluminacion"
        >
          Consultar por iluminación de jardín
        </BotonLuz>
      </div>

      <div class="iluminacion__chicas">
        {fotos.slice(1).map((foto) => (
          <figure class:list={['ilum-foto', !foto.imagen && 'hueco-foto']}>
            {foto.imagen ? (
              <Image
                class="ilum-foto__imagen"
                src={foto.imagen}
                alt={foto.alt}
                widths={[360, 600, 900]}
                sizes="(min-width: 60rem) 26vw, 100vw"
                loading="lazy"
              />
            ) : (
              <Fragment>
                <p class="hueco-foto__etiqueta">{foto.etiqueta}</p>
                <p class="hueco-foto__nota">{foto.nota}</p>
              </Fragment>
            )}
          </figure>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .iluminacion {
    position: relative;
    z-index: var(--z-contenido);
    padding-block: var(--e-10);
    background-color: var(--superficie);
    border-block: 1px solid var(--borde);
  }

  /* En celular es una sola columna y todo va apilado. */
  .iluminacion__grilla {
    display: grid;
    gap: var(--e-6);
  }

  .iluminacion__izquierda,
  .iluminacion__derecha {
    display: grid;
    gap: var(--e-6);
    min-width: 0;
  }

  .iluminacion__texto {
    max-width: var(--ancho-texto);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--e-5);
    color: var(--texto-tenue);
  }

  .iluminacion__texto .guia {
    color: var(--texto);
  }

  .iluminacion__lista {
    display: grid;
    gap: var(--e-3);
    font-size: var(--t-menor);
  }

  .iluminacion__lista li {
    display: flex;
    align-items: baseline;
    gap: var(--e-3);
    color: var(--texto);
  }

  /* Un punto de luz al costado de cada línea. */
  .iluminacion__lista li::before {
    content: '';
    flex: none;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: var(--ambar);
    transform: translateY(-2px);
  }

  /* --- Las fotos --------------------------------------------------------- */

  .ilum-foto {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radio-2);
    min-width: 0;
  }

  .ilum-foto__imagen {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .iluminacion__chicas {
    display: grid;
    gap: var(--e-4);
  }

  /* --- Pantalla ancha ----------------------------------------------------
     Dos columnas. A la izquierda el título y, abajo, la foto principal, que
     se estira hasta llenar el alto que deja la columna de la derecha. Antes
     la foto vivía en una galería aparte y la columna del título quedaba con
     440px de aire abajo, con la galería colgando como un bloque suelto. */

  @media (min-width: 60rem) {
    .iluminacion__grilla {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: var(--e-9);
      row-gap: var(--e-7);
      align-items: stretch;
    }

    .iluminacion__rotulo {
      grid-column: 1 / -1;
      margin-block-end: 0;
    }

    /* La tercera fila (la foto) se queda con todo lo que sobra. */
    .iluminacion__izquierda {
      grid-template-rows: auto 1fr;
    }

    .iluminacion__derecha {
      grid-template-rows: auto auto;
      align-content: start;
      gap: var(--e-7);
    }

    .ilum-foto--grande {
      /* Sin proporción fija: manda el alto de la columna. */
      aspect-ratio: auto;
      min-height: 22rem;
    }

    .iluminacion__chicas {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
