---
import { Image } from 'astro:assets';
import obras from '../data/obras.json';
import { buscarFoto } from '../data/fotos.js';

const casos = obras.map((obra) => ({
  ...obra,
  imagen: buscarFoto(obra.foto),
}));

const faltanCargar = casos.some((obra) => obra.pendiente);
---

<section class="seccion" id="obras" aria-labelledby="t-obras">
  <div class="contenedor">
    <div class="obras__encabezado revelar">
      <p class="rotulo"><span class="rotulo__numero">02</span> Obras</p>
      <h2 class="titulo-2" id="t-obras">Obras realizadas</h2>
      <p class="guia medida obras__intro">
        Instalaciones completas en casas de barrios privados y refacciones sobre
        instalaciones existentes. Cada obra dice dónde fue, qué incluyó y con
        quién se trabajó.
      </p>

      {
        faltanCargar && (
          <p class="obras__aviso">
            <span class="pendiente">Faltan cargar las obras</span>
            <span class="obras__aviso-texto">
              Estos cuatro casos son el molde. Se completan en el archivo
              <code>src/data/obras.json</code> y las fotos van en
              <code>src/images/</code>. Está explicado paso a paso en el
              README.
            </span>
          </p>
        )
      }
    </div>

    <ul class="obras__grilla revelar revelar--secuencia">
      {
        casos.map((obra, i) => (
          <li class="obra" style={`--i:${i}`}>
            <figure
              class:list={['obra__figura', !obra.imagen && 'hueco-foto']}
            >
              {obra.imagen ? (
                <Image
                  class="obra__imagen"
                  src={obra.imagen}
                  alt={obra.alt || `Obra de ${obra.tipo} en ${obra.barrio}.`}
                  widths={[400, 700, 1000]}
                  sizes="(min-width: 62rem) 33vw, (min-width: 40rem) 50vw, 100vw"
                  loading="lazy"
                />
              ) : (
                <>
                  <p class="hueco-foto__etiqueta">{'{FOTO DE LA OBRA}'}</p>
                  <p class="hueco-foto__nota">
                    Una foto del trabajo terminado. Si es de noche y hay
                    iluminación exterior, mejor.
                  </p>
                </>
              )}
            </figure>

            <div class="obra__cuerpo">
              <p class="obra__barrio utilitaria">{obra.barrio}</p>
              <h3 class="titulo-3 obra__tipo">{obra.tipo}</h3>
              <p class="obra__descripcion">{obra.descripcion}</p>
              {obra.pendiente && (
                <p class="pendiente obra__marca">Ejemplo a completar</p>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .obras__encabezado {
    margin-block-end: var(--e-8);
  }

  .obras__intro {
    margin-block-start: var(--e-5);
  }

  .obras__aviso {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-3);
    max-width: var(--ancho-texto);
    margin-block-start: var(--e-5);
    font-size: var(--t-menor);
    line-height: 1.5;
    color: var(--texto-tenue);
  }

  .obras__aviso code {
    font-family: ui-monospace, 'SFMono-Regular', 'Menlo', monospace;
    font-size: 0.92em;
    color: var(--texto);
    background-color: var(--superficie-2);
    padding: 0.1em 0.4em;
    border-radius: var(--radio);
    border: 1px solid var(--borde);
  }

  .obras__grilla {
    display: grid;
    gap: var(--e-6) var(--e-5);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }

  .obra {
    display: flex;
    flex-direction: column;
    gap: var(--e-4);
  }

  .obra__figura {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radio-2);
  }

  .obra__imagen {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .obra__cuerpo {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--e-2);
  }

  .obra__barrio {
    color: var(--ambar);
  }

  .obra__tipo {
    text-wrap: balance;
  }

  .obra__descripcion {
    font-size: var(--t-menor);
    line-height: 1.55;
    color: var(--texto-tenue);
    text-wrap: pretty;
  }

  .obra__marca {
    margin-block-start: var(--e-2);
  }
</style>
