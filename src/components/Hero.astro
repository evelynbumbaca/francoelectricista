---
import { Picture } from 'astro:assets';
import BotonLuz from './BotonLuz.astro';
import { NEGOCIO, linkWhatsapp } from '../data/sitio.js';
import { buscarFoto } from '../data/fotos.js';

const whatsappHero = linkWhatsapp('un presupuesto');

// Si el archivo src/images/hero.jpg existe, se muestra la foto.
// Si no, se muestra el cartel de foto pendiente.
const fotoHero = buscarFoto('hero.jpg');

// Mientras los años no estén cargados, el placeholder se ve en la pantalla.
const aniosCargados = !String(NEGOCIO.aniosOficio).includes('{');

// El compromiso de respuesta tiene tres estados: cargado (se muestra),
// pendiente (se ve el cartel) o vacío (no se muestra la línea).
const compromiso = String(NEGOCIO.compromisoRespuesta ?? '').trim();
const mostrarCompromiso = compromiso !== '';
const compromisoCargado = mostrarCompromiso && !compromiso.includes('{');
---

<section class="hero halo" aria-labelledby="titulo-principal">
  <div class="contenedor">
    <div class="hero__texto">
      <h1 class="titulo-1 hero__titulo" id="titulo-principal">
        Electricista matriculado en zona norte
      </h1>

      <p class="guia hero__bajada">
        Obra nueva en barrios privados junto a estudios de arquitectura,
        refacciones e iluminación de jardín. Presupuesto sin cargo.
      </p>

      <div class="hero__acciones">
        <BotonLuz
          href={whatsappHero}
          variante="primario"
          icono="whatsapp"
          contacto="whatsapp"
          origen="hero"
        >
          Pedir presupuesto por WhatsApp
        </BotonLuz>
        <BotonLuz href="#obras" variante="secundario" icono="flecha" luz={false}>
          Ver obras
        </BotonLuz>
      </div>

      {
        /* Compromiso de respuesta. Si en sitio.js queda vacío, esta línea
           no se dibuja: mejor no decir nada que prometer algo que no se
           cumple. Mientras no esté definido, se ve el cartel de pendiente. */
        mostrarCompromiso && (
          <p class="hero__compromiso">
            {compromisoCargado ? (
              NEGOCIO.compromisoRespuesta
            ) : (
              <span class="pendiente">{'{COMPROMISO_RESPUESTA}'}</span>
            )}
          </p>
        )
      }
    </div>
  </div>

  <!-- FOTO PRINCIPAL —————————————————————————————————————————————
       El espacio ya está reservado con la proporción exacta, así que
       cuando se cargue la foto de verdad la página no se va a mover.
       Instrucciones para reemplazarlo: ver README.md -->
  <div class="contenedor">
    <!-- Se usa Picture y no Image porque esta es la foto más pesada del
         sitio y la que decide la velocidad de carga en pantallas grandes.
         Con Picture el navegador puede elegir AVIF, que pesa bastante menos
         que WebP, y cae a WebP si no lo soporta. -->
    <figure class="hero__figura">
      {
        fotoHero ? (
          <Picture
            class="hero__imagen"
            src={fotoHero}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            alt="Casa de noche con la iluminación de jardín encendida y luz cálida saliendo del interior."
            widths={[640, 960, 1200, 1536]}
            sizes="(min-width: 1240px) 1144px, 100vw"
            loading="eager"
            fetchpriority="high"
            decoding="sync"
          />
        ) : (
          <div class="hueco-foto hero__hueco">
            <p class="hueco-foto__etiqueta">{'{FOTO_HERO}'}</p>
            <p class="hueco-foto__nota">
              Obra terminada o jardín iluminado de noche, apaisada. Que no sea
              un retrato: el retrato va más abajo, en «Sobre Franco».
            </p>
          </div>
        )
      }
    </figure>
  </div>

  <div class="contenedor">
    <ul class="hero__datos">
      <li class="hero__dato">
        <span class="utilitaria hero__dato-clave">Oficio</span>
        <span class="hero__dato-valor">
          {
            aniosCargados ? (
              <Fragment>{NEGOCIO.aniosOficio} años en zona norte</Fragment>
            ) : (
              <Fragment>
                <span class="pendiente">{'{AÑOS}'}</span> años en zona norte
              </Fragment>
            )
          }
        </span>
      </li>
      <li class="hero__dato">
        <span class="utilitaria hero__dato-clave">Trabajo en</span>
        <span class="hero__dato-valor">
          Nordelta, Benavídez, Pilar, Escobar y San Fernando
        </span>
      </li>
      <li class="hero__dato">
        <span class="utilitaria hero__dato-clave">Atención</span>
        <span class="hero__dato-valor">{NEGOCIO.horarioTexto}</span>
      </li>
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: var(--z-contenido);
    padding-block: clamp(3rem, 2rem + 6vw, 7rem) var(--e-9);
  }

  .hero__titulo {
    max-width: 17ch;
    margin-block-end: var(--e-6);
  }

  .destacado {
    color: var(--ambar);
  }

  .hero__bajada {
    max-width: var(--ancho-texto);
    margin-block-end: var(--e-7);
  }

  .hero__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-4);
  }

  .hero__compromiso {
    margin-block-start: var(--e-4);
    font-size: var(--t-menor);
    color: var(--texto-tenue);
  }

  .hero__texto {
    margin-block-end: var(--e-8);
  }

  /* --- La foto principal ------------------------------------------------ */

  .hero__figura {
    position: relative;
    /* 16/9 y no 16/8: con la caja más alta entra el piso, que es donde
       están los artefactos y el trabajo que se quiere mostrar. */
    aspect-ratio: 16 / 9;
    margin-block-end: var(--e-7);
    overflow: hidden;
    border-radius: var(--radio-2);
  }

  /* IMPORTANTE: Picture envuelve la imagen en un <picture>, y ese elemento
     tiene que ocupar toda la figura. Si no, la imagen no encuentra contra
     qué calcular su alto, se queda con su alto natural y termina
     desbordando: en vez de recortarse por el centro, se corta todo abajo
     y desaparece el piso. */
  .hero__figura :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero__hueco,
  .hero__imagen {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* El recorte se corre hacia abajo: arriba sobra cielo, abajo está el
       césped con los artefactos encendidos. */
    object-position: 50% 70%;
  }

  @media (max-width: 46rem) {
    .hero__figura {
      aspect-ratio: 4 / 3;
    }

    .hero__acciones > :global(.boton) {
      width: 100%;
    }
  }

  /* --- Los tres datos duros --------------------------------------------- */

  .hero__datos {
    display: grid;
    gap: var(--e-5);
    padding-block-start: var(--e-6);
    border-block-start: 1px solid var(--borde);
  }

  @media (min-width: 46rem) {
    .hero__datos {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--e-6);
    }
  }

  .hero__dato {
    display: flex;
    flex-direction: column;
    gap: var(--e-2);
  }

  .hero__dato-clave {
    color: var(--ambar);
  }

  .hero__dato-valor {
    font-size: var(--t-menor);
    line-height: 1.45;
    color: var(--texto-tenue);
  }
</style>
