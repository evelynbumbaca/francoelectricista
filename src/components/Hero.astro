---
import { getImage } from 'astro:assets';
import { existsSync } from 'node:fs';
import BotonLuz from './BotonLuz.astro';
import { NEGOCIO, linkWhatsapp } from '../data/sitio.js';
import { buscarFoto } from '../data/fotos.js';

const whatsappHero = linkWhatsapp('un presupuesto');

/* --- La imagen de arriba de todo -------------------------------------
   Hay dos fotos distintas a propósito:

   · hero.jpg es el PRIMER cuadro del video, con la casa todavía apagada
     al atardecer. Va en pantallas grandes, donde después arranca el
     video: al ser el mismo cuadro, el empalme no se nota.
   · hero-celular.jpg es el ÚLTIMO cuadro, con todo encendido. Va en
     celular, donde el video no se carga nunca, así que conviene mostrar
     directamente la casa iluminada, que es el resultado del trabajo.

   Nadie ve las dos: cada pantalla baja solo la suya. */
const fotoHero = buscarFoto('hero.jpg');
const fotoHeroCelular = buscarFoto('hero-celular.jpg') || fotoHero;

const ALT_HERO =
  'Casa al atardecer con la iluminación de jardín y del interior encendiéndose.';

/* El video solo existe si los dos archivos están puestos. Si alguien los
   borra, el sitio sigue andando con la foto y no queda un hueco negro. */
const hayVideo =
  Boolean(fotoHero) &&
  existsSync('public/video/hero.webm') &&
  existsSync('public/video/hero.mp4');

// Pósters art-dirigidos: cada pantalla baja únicamente el suyo.
const posterCelular = fotoHeroCelular
  ? await getImage({
      src: fotoHeroCelular,
      widths: [420, 640, 900],
      format: 'avif',
      quality: 48,
    })
  : null;

const posterEscritorio = fotoHero
  ? await getImage({
      src: fotoHero,
      widths: [960, 1280, 1600],
      format: 'avif',
      quality: 44,
    })
  : null;

// Respaldo en un formato que entiende cualquier navegador.
const posterRespaldo = fotoHeroCelular
  ? await getImage({
      src: fotoHeroCelular,
      width: 1024,
      format: 'webp',
      quality: 55,
    })
  : null;

// Mientras los años no estén cargados, el placeholder se ve en la pantalla.
const aniosCargados = !String(NEGOCIO.aniosOficio).includes('{');

// El compromiso de respuesta tiene tres estados: cargado (se muestra),
// pendiente (se ve el cartel) o vacío (no se muestra la línea).
const compromiso = String(NEGOCIO.compromisoRespuesta ?? '').trim();
const mostrarCompromiso = compromiso !== '';
const compromisoCargado = mostrarCompromiso && !compromiso.includes('{');
---

{/*
  EL BLOQUE DE ARRIBA DE TODO

  Con foto cargada, la foto es el fondo de toda esta primera pantalla y el
  texto va encima. Así, apenas se entra, se ve un trabajo terminado en vez
  de un bloque de texto con una foto más abajo.

  Sin foto, el bloque vuelve al orden normal (texto, botones y el cartel
  que dice qué foto falta), porque un fondo vacío no tendría sentido.
*/}
<section
  class:list={['hero', 'halo', fotoHero && 'hero--con-fondo']}
  aria-labelledby="titulo-principal"
>
  {
    fotoHero && (
      <div class="hero__fondo">
        <picture>
          <source
            media="(min-width: 60rem)"
            type="image/avif"
            srcset={posterEscritorio.srcSet.attribute}
            sizes="100vw"
          />
          <source
            type="image/avif"
            srcset={posterCelular.srcSet.attribute}
            sizes="100vw"
          />
          <img
            class="hero__imagen"
            src={posterRespaldo.src}
            alt={ALT_HERO}
            width={posterRespaldo.attributes.width}
            height={posterRespaldo.attributes.height}
            fetchpriority="high"
            decoding="sync"
          />
        </picture>

        {hayVideo && (
          /* El video se monta encima del póster y aparece con un fundido.
             Arranca sin fuente y sin precarga: recién se le pone el archivo
             cuando la página terminó de cargar, para que nunca le compita
             a la imagen principal. Ver el script del final. */
          <video
            class="hero__video"
            data-hero-video
            data-webm="/video/hero.webm"
            data-mp4="/video/hero.mp4"
            muted
            playsinline
            preload="none"
            aria-hidden="true"
            tabindex="-1"
          />
        )}
      </div>
    )
  }

  <div class="contenedor hero__contenido">
    <h1 class="titulo-1 hero__titulo" id="titulo-principal">
      Electricista matriculado en zona norte
    </h1>

    <p class="guia hero__bajada">
      Obra nueva en barrios privados junto a estudios de arquitectura,
      refacciones e iluminación de jardín. Presupuesto sin cargo.
    </p>

    <div class="hero__acciones">
      <BotonLuz
        href={whatsappHero}
        variante="primario"
        icono="whatsapp"
        contacto="whatsapp"
        origen="hero"
      >
        Pedir presupuesto por WhatsApp
      </BotonLuz>
      <BotonLuz href="#servicios" variante="secundario" icono="flecha" luz={false}>
        Ver servicios
      </BotonLuz>
    </div>

    {
      /* Compromiso de respuesta. Si en sitio.js queda vacío, esta línea no
         se dibuja: mejor no decir nada que prometer algo que no se cumple. */
      mostrarCompromiso && (
        <p class="hero__compromiso">
          {compromisoCargado ? (
            NEGOCIO.compromisoRespuesta
          ) : (
            <span class="pendiente">{'{COMPROMISO_RESPUESTA}'}</span>
          )}
        </p>
      )
    }
  </div>

  {
    !fotoHero && (
      <div class="contenedor">
        <figure class="hero__figura">
          <div class="hueco-foto hero__hueco">
            <p class="hueco-foto__etiqueta">{'{FOTO_HERO}'}</p>
            <p class="hueco-foto__nota">
              Obra terminada o jardín iluminado de noche, apaisada. Que no sea
              un retrato: el retrato va más abajo, en «Sobre Franco».
            </p>
          </div>
        </figure>
      </div>
    )
  }

  <div class="contenedor">
    <ul class="hero__datos">
      <li class="hero__dato">
        <span class="utilitaria hero__dato-clave">Oficio</span>
        <span class="hero__dato-valor">
          {
            aniosCargados ? (
              <Fragment>{NEGOCIO.aniosOficio} años en zona norte</Fragment>
            ) : (
              <Fragment>
                <span class="pendiente">{'{AÑOS}'}</span> años en zona norte
              </Fragment>
            )
          }
        </span>
      </li>
      <li class="hero__dato">
        <span class="utilitaria hero__dato-clave">Trabajo en</span>
        <span class="hero__dato-valor">
          Nordelta, Benavídez, Pilar, Escobar y San Fernando
        </span>
      </li>
      <li class="hero__dato">
        <span class="utilitaria hero__dato-clave">Atención</span>
        <span class="hero__dato-valor">{NEGOCIO.horarioTexto}</span>
      </li>
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: var(--z-contenido);
    padding-block: clamp(3rem, 2rem + 6vw, 7rem) var(--e-9);
  }

  /* --- Con foto: ocupa la primera pantalla y la foto va detrás ---------- */

  .hero--con-fondo {
    /* isolation crea una capa propia, para que la foto pueda ir en z-index
       negativo sin escaparse por detrás del fondo de la página. */
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    /* svh es el alto real de la pantalla del celular, descontando la barra
       del navegador. vh queda de respaldo para navegadores viejos. */
    min-height: 86vh;
    min-height: 86svh;
    padding-block: var(--e-9) var(--e-7);
  }

  .hero__fondo {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  /* El <picture> tiene que ocupar todo: si no, la imagen se queda con su
     alto natural y desborda en lugar de recortarse. */
  .hero__fondo picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero__imagen,
  .hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* El recorte se corre hacia abajo: arriba sobra cielo, abajo está el
       césped con los artefactos encendidos. */
    object-position: 50% 68%;
  }

  /* El video se monta encima del póster y aparece con un fundido corto.
     Arranca invisible: recién se muestra cuando de verdad está andando,
     así nunca se ve un rectángulo negro mientras carga. */
  .hero__video {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 700ms var(--ease-suave);
  }

  .hero__video--visible {
    opacity: 1;
  }

  /* En celular no se carga el video, así que no hace falta ni dibujarlo. */
  @media (max-width: 60rem) {
    .hero__video {
      display: none;
    }
  }

  /* En celular la pantalla es mucho más alta que ancha, así que de una foto
     apaisada entra una franja angosta. Se corre a la derecha para que esa
     franja agarre la casa iluminada y no solamente el árbol. */
  @media (max-width: 46rem) {
    .hero__imagen {
      object-position: 62% 60%;
    }
  }

  /* El velo que hace legible el texto sobre la foto. Es el mismo color de
     fondo del sitio, así que la foto no se ensucia: se apaga. */
  .hero__fondo::after {
    content: '';
    position: absolute;
    inset: 0;
    /* En celular el texto ocupa el ancho completo y se apoya abajo, así que
       el velo tiene que subir desde abajo. Un degradado lateral no lo
       protegería. */
    background: linear-gradient(
      to top,
      var(--fondo) 5%,
      rgb(20 17 16 / 0.94) 36%,
      rgb(20 17 16 / 0.62) 66%,
      rgb(20 17 16 / 0.22) 100%
    );
  }

  /* Sobre la foto, la bajada va en el texto pleno y no en el tenue.
     Medido: con el tono tenue quedaba en 2,9:1 sobre las ventanas
     iluminadas de la foto, por debajo del mínimo legible. */
  .hero--con-fondo .hero__bajada {
    color: var(--texto);
  }

  @media (min-width: 60rem) {
    /* En pantalla ancha el texto ocupa la mitad izquierda, así que el velo
       cae de izquierda a derecha y deja respirar la foto del lado derecho. */
    .hero__fondo::after {
      background: linear-gradient(
          to right,
          var(--fondo) 0%,
          rgb(20 17 16 / 0.95) 30%,
          rgb(20 17 16 / 0.7) 56%,
          rgb(20 17 16 / 0.16) 100%
        ),
        /* Una segunda capa, baja y corta, solo para que la fila de datos de
           abajo se lea también sobre la parte clara de la imagen. Arriba no
           llega, así que el cielo y la casa quedan a la vista. */
        linear-gradient(
          to top,
          rgb(20 17 16 / 0.86) 0%,
          rgb(20 17 16 / 0.28) 22%,
          transparent 44%
        );
    }

    /* El texto se queda en la mitad izquierda, que es donde el velo tapa
       más. La bajada se angosta para no meterse en la parte donde la foto
       respira. El contenedor no se toca: sigue centrado como el resto del
       sitio, así el texto queda alineado con las demás secciones. */
    /* 40ch y no más: medido, con la bajada más ancha el texto se metía en
       la zona donde el video enciende el alero y el contraste caía a
       3,7:1. Angostarla la mantiene sobre la parte protegida del velo. */
    .hero--con-fondo .hero__bajada {
      max-width: 40ch;
    }
  }

  /* --- Texto ------------------------------------------------------------ */

  .hero__titulo {
    max-width: 17ch;
    margin-block-end: var(--e-6);
  }

  .hero__bajada {
    max-width: var(--ancho-texto);
    margin-block-end: var(--e-7);
  }

  .hero__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-4);
  }

  .hero__compromiso {
    margin-block-start: var(--e-4);
    font-size: var(--t-menor);
    color: var(--texto-tenue);
  }

  .hero__contenido {
    margin-block-end: var(--e-8);
  }

  /* --- Sin foto: el hueco que dice qué falta ---------------------------- */

  .hero__figura {
    position: relative;
    aspect-ratio: 16 / 9;
    margin-block-end: var(--e-7);
    overflow: hidden;
    border-radius: var(--radio-2);
  }

  .hero__hueco {
    width: 100%;
    height: 100%;
  }

  @media (max-width: 46rem) {
    .hero__figura {
      aspect-ratio: 4 / 3;
    }

    .hero__acciones > :global(.boton) {
      width: 100%;
    }
  }

  /* --- Los tres datos duros --------------------------------------------- */

  .hero__datos {
    display: grid;
    gap: var(--e-5);
    padding-block-start: var(--e-6);
    border-block-start: 1px solid var(--borde);
  }

  /* Sobre la foto, el borde de hilo necesita algo más de presencia. */
  .hero--con-fondo .hero__datos {
    border-block-start-color: rgb(240 234 227 / 0.22);
  }

  @media (min-width: 46rem) {
    .hero__datos {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--e-6);
    }
  }

  .hero__dato {
    display: flex;
    flex-direction: column;
    gap: var(--e-2);
  }

  .hero__dato-clave {
    color: var(--ambar);
  }

  .hero__dato-valor {
    font-size: var(--t-menor);
    line-height: 1.45;
    color: var(--texto-tenue);
  }
</style>

<script>
  // ====================================================================
  // EL VIDEO DE ARRIBA DE TODO
  //
  // Reglas, en orden de importancia:
  //  1. El video NUNCA le compite a la imagen principal. Por eso arranca
  //     sin fuente y sin precarga, y recién se le pone el archivo cuando
  //     la página ya terminó de cargar del todo.
  //  2. En celular no se carga nunca. Es donde está la mayoría del
  //     tráfico y donde los datos se pagan.
  //  3. Si la persona pidió menos animaciones, tampoco. Un video de fondo
  //     es exactamente el tipo de movimiento que esa opción quiere evitar.
  //  4. Si el navegador avisa que la conexión es mala o que hay ahorro de
  //     datos activado, tampoco.
  //  5. Se reproduce una sola vez y queda quieto en el último cuadro, con
  //     la casa iluminada. No se repite en loop.
  // ====================================================================

  const video = document.querySelector('[data-hero-video]');

  if (video) {
    const pantallaGrande = window.matchMedia('(min-width: 60rem)');
    const menosMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)');

    const conexion =
      navigator.connection || navigator.mozConnection || navigator.webkitConnection;
    const conexionPobre = Boolean(
      conexion &&
        (conexion.saveData === true ||
          ['slow-2g', '2g', '3g'].includes(conexion.effectiveType))
    );

    const corresponde =
      pantallaGrande.matches && !menosMovimiento.matches && !conexionPobre;

    if (corresponde) {
      const arrancar = () => {
        for (const [archivo, tipo] of [
          [video.dataset.webm, 'video/webm'],
          [video.dataset.mp4, 'video/mp4'],
        ]) {
          const fuente = document.createElement('source');
          fuente.src = archivo;
          fuente.type = tipo;
          video.appendChild(fuente);
        }

        // Recién cuando está andando de verdad se hace visible, para que
        // nunca aparezca un rectángulo negro sobre el póster.
        video.addEventListener(
          'playing',
          () => video.classList.add('hero__video--visible'),
          { once: true }
        );

        video.load();
        // Si el navegador bloquea la reproducción automática, no pasa nada:
        // queda el póster, que ya es la imagen que corresponde.
        const intento = video.play();
        if (intento && typeof intento.catch === 'function') intento.catch(() => {});
      };

      if (document.readyState === 'complete') {
        arrancar();
      } else {
        window.addEventListener('load', arrancar, { once: true });
      }
    }
  }
</script>
