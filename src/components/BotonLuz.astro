---
/**
 * BOTÓN CON LUZ
 *
 * El gesto distintivo del sitio: al tocarlo, se enciende una luz cálida
 * que nace exactamente en el punto donde apoyaste el dedo o el mouse.
 *
 * Lo que hace que se lea como LUZ y no como un efecto de botón cualquiera:
 *  1. Prende rápido (120ms) y se apaga lento (450ms). Como una lámpara.
 *  2. Arranca en ámbar oscuro y sube a ámbar claro en los primeros 150ms,
 *     igual que un filamento que se va calentando.
 *  3. Nace en el punto de contacto, no en el centro del botón.
 *
 * Se usa SOLO en el botón principal y en la barra de WhatsApp del celular.
 * Si estuviera en todos lados dejaría de ser un gesto y sería ruido.
 */

interface Props {
  href: string;
  variante?: 'primario' | 'secundario' | 'barra';
  icono?: 'whatsapp' | 'telefono' | 'flecha' | 'ninguno';
  /** Se usa para medir después: "whatsapp" o "telefono". */
  contacto?: 'whatsapp' | 'telefono';
  /** Desde qué parte del sitio se tocó. Ejemplo: "hero", "contacto". */
  origen?: string;
  /** Si el botón lleva el efecto de luz. Por defecto, sí. */
  luz?: boolean;
  ancho?: boolean;
  clase?: string;
}

const {
  href,
  variante = 'primario',
  icono = 'ninguno',
  contacto,
  origen,
  luz = true,
  ancho = false,
  clase = '',
} = Astro.props;

const externo = href.startsWith('http');
const clases = [
  'boton',
  `boton--${variante}`,
  ancho ? 'boton--ancho' : '',
  clase,
]
  .filter(Boolean)
  .join(' ');
---

<a
  class={clases}
  href={href}
  data-luz={luz ? '' : undefined}
  data-contacto={contacto}
  data-origen={origen}
  rel={externo ? 'noopener' : undefined}
  target={externo ? '_blank' : undefined}
>
  <span class="boton__texto">
    {
      icono === 'whatsapp' && (
        <svg
          class="boton__icono"
          viewBox="0 0 24 24"
          width="20"
          height="20"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.18 8.18 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.83 2.42a8.18 8.18 0 0 1 2.41 5.82c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.79.97-.14.16-.29.18-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.47c-.17 0-.43.06-.66.31-.23.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.14-1.18-.06-.11-.22-.17-.47-.29Z" />
        </svg>
      )
    }
    {
      icono === 'telefono' && (
        <svg
          class="boton__icono"
          viewBox="0 0 24 24"
          width="20"
          height="20"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z" />
        </svg>
      )
    }
    <slot />
    {
      icono === 'flecha' && (
        <svg
          class="boton__icono boton__icono--flecha"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="square"
          aria-hidden="true"
        >
          <path d="M5 12h13M12 5.5 18.5 12 12 18.5" />
        </svg>
      )
    }
  </span>
</a>

<style>
  .boton {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--toque-minimo);
    padding: var(--e-3) var(--e-6);
    border-radius: var(--radio);
    font-family: var(--fuente-display);
    font-size: var(--t-menor);
    font-weight: 600;
    font-stretch: 100%;
    letter-spacing: 0.01em;
    line-height: 1.2;
    text-align: center;
    /* Evita el destello gris de Android/iOS al tocar: la luz es nuestra. */
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    transition: background-color var(--transicion-ui),
      border-color var(--transicion-ui), color var(--transicion-ui);
  }

  .boton__texto {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: var(--e-3);
  }

  .boton__icono {
    flex: none;
  }

  .boton__icono--flecha {
    transition: transform var(--transicion-ui);
  }

  .boton:hover .boton__icono--flecha {
    transform: translateX(3px);
  }

  .boton--ancho {
    width: 100%;
  }

  /* --- Variantes ------------------------------------------------------- */

  .boton--primario {
    background-color: var(--ambar);
    color: var(--fondo); /* 10.6:1 — contraste de sobra */
    border: 1px solid var(--ambar);
  }

  .boton--primario:hover {
    background-color: var(--ambar-calido);
    border-color: var(--ambar-calido);
  }

  .boton--secundario {
    background-color: transparent;
    color: var(--texto);
    border: 1px solid var(--borde);
  }

  .boton--secundario:hover {
    border-color: var(--ambar-a64);
    color: var(--ambar);
  }

  .boton--barra {
    flex: 1;
    min-height: var(--toque-minimo);
    border-radius: var(--radio);
    background-color: var(--superficie-2);
    color: var(--texto);
    border: 1px solid var(--borde);
    font-size: var(--t-menor);
  }

  /* --- EL ENCENDIDO ----------------------------------------------------
     Dos capas de luz, una encima de la otra:
       · la fría (ámbar profundo) prende primero y se apaga enseguida
       · la cálida (ámbar claro) toma la posta y se apaga despacio
     El cruce entre las dos es lo que hace que el color "suba de
     temperatura", como el filamento de una lamparita.

     Se animan únicamente opacidad y escala. Nunca sombras ni desenfoques:
     esos dos matan los cuadros por segundo en los celulares, que es
     donde va a estar la mayoría de las visitas. */

  .boton::before,
  .boton::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0;
    /* La luz nace en el punto de contacto, no en el centro del botón: por
       eso el origen de la escala son las coordenadas del dedo o el mouse. */
    transform-origin: var(--lx, 50%) var(--ly, 50%);
    will-change: opacity, transform;
  }

  /* Capa 1: el filamento todavía frío. Sobre el ámbar del botón se ve como
     un núcleo más oscuro y más saturado. */
  .boton::before {
    background: radial-gradient(
      circle 130px at var(--lx, 50%) var(--ly, 50%),
      var(--ambar-profundo) 0%,
      rgb(216 130 42 / 0.55) 40%,
      transparent 72%
    );
  }

  /* Capa 2: el filamento ya caliente. Es más clara que el fondo del botón,
     así que la transición de una capa a la otra se lee como calor subiendo. */
  .boton::after {
    background: radial-gradient(
      circle 160px at var(--lx, 50%) var(--ly, 50%),
      var(--ambar-calido) 0%,
      rgb(255 217 160 / 0.6) 40%,
      transparent 70%
    );
  }

  .boton.encendiendo::before {
    animation: luz-filamento 570ms linear forwards;
  }

  .boton.encendiendo::after {
    animation: luz-calida 570ms linear forwards;
  }

  /* Los tiempos, sobre un total de 570ms:
       10% ≈  60ms  → la capa fría llega a pleno. Este es el golpe de
                      encendido: es lo que el ojo lee como "prendió rápido".
       22% ≈ 125ms  → la capa cálida termina de entrar y tapa a la fría.
                      Entre los 60 y los 125ms el color sube de temperatura.
       26% ≈ 148ms  → la fría ya se apagó del todo.
       100% = 570ms → la cálida termina de caer.

     La clave está en los easings: la capa fría entra con una curva
     rapidísima y la cálida entra con una curva lenta al principio. Si las
     dos entraran igual, la cálida taparía a la fría al instante y no se
     vería ninguna deriva de color: sería un destello común. */

  @keyframes luz-filamento {
    0% {
      opacity: 0;
      transform: scale(0.28);
      animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    }
    10% {
      opacity: 1;
      transform: scale(0.9);
      animation-timing-function: cubic-bezier(0.4, 0, 1, 1);
    }
    26% {
      opacity: 0;
      transform: scale(1.2);
    }
    100% {
      opacity: 0;
      transform: scale(1.25);
    }
  }

  @keyframes luz-calida {
    0% {
      opacity: 0;
      transform: scale(0.4);
      /* Entrada lenta a propósito: deja ver la capa fría primero. */
      animation-timing-function: cubic-bezier(0.55, 0, 1, 0.45);
    }
    22% {
      opacity: 1;
      transform: scale(1.05);
      /* Caída con entrada suave: la luz se queda un rato y recién
         después se apaga, como el filamento que sigue caliente. */
      animation-timing-function: cubic-bezier(0.4, 0, 1, 1);
    }
    100% {
      opacity: 0;
      transform: scale(1.7);
    }
  }

  /* Si la persona pidió menos animaciones: nada se mueve. El botón cambia
     de estado al instante y sigue siendo perfectamente usable. */
  @media (prefers-reduced-motion: reduce) {
    .boton::before,
    .boton::after {
      display: none;
    }

    .boton:active {
      background-color: var(--ambar-calido);
      color: var(--fondo);
      border-color: var(--ambar-calido);
    }
  }
</style>
